<Window x:Class="TS6_SpeakerOverlay.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:TS6_SpeakerOverlay.ViewModels"
        xmlns:helpers="clr-namespace:TS6_SpeakerOverlay.Helpers"
        Title="TS6 Overlay"
        Width="320" Height="600"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        FontFamily="Microsoft YaHei UI, Segoe UI Variable Text, Segoe UI"
        TextOptions.TextFormattingMode="Display"
        Left="{Binding Config.WindowLeft, Mode=TwoWay}"
        Top="{Binding Config.WindowTop, Mode=TwoWay}">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <helpers:SpacingConverter x:Key="SpacingConverter"/>
        <SolidColorBrush x:Key="VoiceBrush" Color="#19B889"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#90A5AA"/>
        <SolidColorBrush x:Key="AmberBrush" Color="#F3B562"/>
        <Geometry x:Key="IconMic">M12,14 C13.66,14 15,12.66 15,11 L15,6 C15,4.34 13.66,3 12,3 C10.34,3 9,4.34 9,6 L9,11 C9,12.66 10.34,14 12,14 Z M6,10 L6,11 C6,14.07 8.34,16.59 11.33,16.92 L11.33,20 L8,20 L8,22 L16,22 L16,20 L12.67,20 L12.67,16.92 C15.66,16.59 18,14.07 18,11 L18,10 L16,10 L16,11 C16,13.21 14.21,15 12,15 C9.79,15 8,13.21 8,11 L8,10 Z</Geometry>
        <Geometry x:Key="IconSlash">M4,4 L20,20</Geometry>
        <Geometry x:Key="IconHeadsetOff">M12,4C7.58,4 4,7.58 4,12V18H7V12C7,9.24 9.24,7 12,7C14.76,7 17,9.24 17,12V13.17L19.76,15.93C19.91,15.65 20,15.33 20,15V12C20,7.58 16.42,4 12,4M2.28,3L1,4.27L4.75,8.02C3.06,8.88 1.96,10.59 2,12.5V19H8V13H6.81L10,16.19V19H12.81L16,22.19L17.27,20.92L2.28,3M19,16.19V19H22V16.19C22,15.33 21.65,14.56 21.09,14L19,11.91L18.09,12.82C18.65,13.38 19,14.24 19,16.19Z</Geometry>
        <Geometry x:Key="IconAway">M17.75,4.09L15.22,6.03L16.13,9.09L13.5,7.28L10.87,9.09L11.78,6.03L9.25,4.09L12.44,4L13.5,1L14.56,4L17.75,4.09M21.25,11L19.61,12.25L20.2,14.23L18.5,13.06L16.8,14.23L17.39,12.25L15.75,11L17.81,10.95L18.5,9L19.19,10.95L21.25,11M18.97,15.95C19.8,15.87 20.69,17.05 20.16,17.8C19.84,18.25 19.5,18.67 19.08,19.07C15.17,23 8.84,23 4.94,19.07C1.03,15.17 1.03,8.83 4.94,4.93C5.34,4.53 5.76,4.17 6.21,3.85C6.96,3.32 8.14,4.21 8.06,5.04C6.94,10.39 9.79,15.72 15.05,17.77C16.32,18.26 17.67,18.39 18.97,15.95Z</Geometry>
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Key="L" Modifiers="Control" Command="{Binding ToggleLockStateCommand}"
                    CommandParameter="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType=Window}}"/>
    </Window.InputBindings>

    <Grid>
        <Grid.LayoutTransform>
            <ScaleTransform ScaleX="{Binding Config.UiScale}" ScaleY="{Binding Config.UiScale}"/>
        </Grid.LayoutTransform>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ItemsControl Grid.Row="0" ItemsSource="{Binding Notifications}" Margin="10,4,10,8">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><StackPanel/></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Margin="0,0,0,6" Background="#F2172B32" BorderBrush="#46636A"
                            BorderThickness="1" CornerRadius="10" SnapsToDevicePixels="True">
                        <Border.Triggers>
                            <EventTrigger RoutedEvent="Loaded">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.16"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Border.Triggers>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="4"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Background="{Binding Color}" CornerRadius="10,0,0,10"/>
                            <TextBlock Grid.Column="1" Text="{Binding Icon}" Foreground="{Binding Color}"
                                       FontSize="15" Margin="10,7,8,7" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="{Binding Message}" Foreground="#F0F8F8"
                                       FontSize="12" FontWeight="Medium" Margin="0,7,12,7"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Grid Grid.Row="1">
            <ItemsControl ItemsSource="{Binding Users}" Margin="8,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid x:Name="UserRow"
                              Margin="{Binding DataContext.Config.ItemSpacing, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource SpacingConverter}}"
                              HorizontalAlignment="Left">
                            <Border x:Name="RowSurface" Background="#EB14272E" Opacity="{Binding DataContext.Config.BackgroundOpacity, RelativeSource={RelativeSource AncestorType=Window}}"
                                    BorderBrush="#365059" BorderThickness="1" CornerRadius="10"/>
                            <Border x:Name="TalkingSurface"
                                    Background="{Binding DataContext.Config.TalkingSurfaceBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                    BorderBrush="{Binding DataContext.Config.TalkingBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                    BorderThickness="1.5" CornerRadius="10" Opacity="0" IsHitTestVisible="False"/>
                            <Grid x:Name="RowContent" Margin="10,7,12,7">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition x:Name="VoiceColumn" Width="18"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition x:Name="NameColumn" Width="*"/>
                                    <ColumnDefinition x:Name="StatusColumn" Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Grid x:Name="VoiceMeter" Width="12" Height="22" HorizontalAlignment="Left" VerticalAlignment="Center" Opacity="0.28">
                                    <Rectangle x:Name="MeterA" Width="2" Height="7" RadiusX="1" RadiusY="1" Fill="#90A5AA" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                    <Rectangle x:Name="MeterB" Width="2" Height="15" RadiusX="1" RadiusY="1" Fill="#90A5AA" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                    <Rectangle x:Name="MeterC" Width="2" Height="11" RadiusX="1" RadiusY="1" Fill="#90A5AA" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                    <Rectangle x:Name="MeterOnA" Width="2" Height="7" RadiusX="1" RadiusY="1" Fill="{Binding DataContext.Config.TalkingBrush, RelativeSource={RelativeSource AncestorType=Window}}" Opacity="0" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                    <Rectangle x:Name="MeterOnB" Width="2" Height="15" RadiusX="1" RadiusY="1" Fill="{Binding DataContext.Config.TalkingBrush, RelativeSource={RelativeSource AncestorType=Window}}" Opacity="0" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                    <Rectangle x:Name="MeterOnC" Width="2" Height="11" RadiusX="1" RadiusY="1" Fill="{Binding DataContext.Config.TalkingBrush, RelativeSource={RelativeSource AncestorType=Window}}" Opacity="0" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                </Grid>

                                <Border x:Name="AvatarContainer" Grid.Column="1"
                                        Width="{Binding DataContext.Config.AvatarSize, RelativeSource={RelativeSource AncestorType=Window}}"
                                        Height="{Binding DataContext.Config.AvatarSize, RelativeSource={RelativeSource AncestorType=Window}}"
                                        Margin="0,0,9,0" CornerRadius="20">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding DataContext.Config.AvatarDisplayMode, RelativeSource={RelativeSource AncestorType=Window}}" Value="None">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <Border x:Name="AvatarBackground" Background="{Binding NameColor}" CornerRadius="20"/>
                                        <TextBlock x:Name="Initials" Text="{Binding Initials}" Foreground="White" FontSize="10"
                                                   FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <Border x:Name="AvatarImage" CornerRadius="20">
                                            <Border.Background>
                                                <ImageBrush ImageSource="{Binding ServerAvatarPath}" Stretch="UniformToFill"/>
                                            </Border.Background>
                                        </Border>
                                        <Border x:Name="AvatarGlow" Margin="-3" CornerRadius="24" BorderThickness="2.5"
                                                BorderBrush="{Binding DataContext.Config.TalkingBrush, RelativeSource={RelativeSource AncestorType=Window}}" Opacity="0" Visibility="Collapsed"
                                                Effect="{Binding DataContext.Config.TalkingGlowEffect, RelativeSource={RelativeSource AncestorType=Window}}"
                                                IsHitTestVisible="False" RenderTransformOrigin="0.5,0.5">
                                            <Border.RenderTransform>
                                                <ScaleTransform ScaleX="0.86" ScaleY="0.86"/>
                                            </Border.RenderTransform>
                                        </Border>
                                        <Border x:Name="SpeakingRing" CornerRadius="20" BorderThickness="2"
                                                BorderBrush="{Binding DataContext.Config.TalkingBrush, RelativeSource={RelativeSource AncestorType=Window}}" Opacity="0"/>
                                        <Border x:Name="AvatarMicBadge" Width="10" Height="10" CornerRadius="5"
                                                Background="#FF6B78" BorderBrush="#FFDEE3" BorderThickness="1"
                                                HorizontalAlignment="Right" VerticalAlignment="Top"
                                                ToolTip="{DynamicResource Lang_Status_MicMuted}" Visibility="Collapsed">
                                            <Viewbox Width="6" Height="6" Stretch="Uniform">
                                                <Grid Width="24" Height="24">
                                                    <Path Data="{StaticResource IconMic}" Fill="White" Stretch="None"/>
                                                </Grid>
                                            </Viewbox>
                                        </Border>
                                        <Border x:Name="AvatarAudioBadge" Width="10" Height="10" CornerRadius="5"
                                                Background="#F3B562" BorderBrush="#FFF0D1" BorderThickness="1"
                                                HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                ToolTip="{DynamicResource Lang_Status_AudioMuted}" Visibility="Collapsed">
                                            <Path Data="{StaticResource IconHeadsetOff}" Fill="#241A0D" Width="6" Height="6" Stretch="Uniform"/>
                                        </Border>
                                    </Grid>
                                </Border>

                                <TextBlock x:Name="UserName" Grid.Column="2" Text="{Binding Name}" Foreground="#F0F8F8"
                                           FontSize="{Binding DataContext.Config.FontSize, RelativeSource={RelativeSource AncestorType=Window}}"
                                           FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0"
                                           TextTrimming="CharacterEllipsis" MaxWidth="190"/>

                                <StackPanel x:Name="StatusPanel" Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Margin="2,0" Padding="4,3" CornerRadius="5"
                                            Background="#4A202B" BorderBrush="#8FFF6B78" BorderThickness="1"
                                            ToolTip="{DynamicResource Lang_Status_MicMuted}">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsInputMuted}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Viewbox Width="17" Height="17" Stretch="Uniform">
                                            <Grid Width="24" Height="24">
                                                <Path Data="{StaticResource IconMic}" Fill="#FFF1F3" Stretch="None"/>
                                                <Path Data="{StaticResource IconSlash}" Stroke="#FF8792" StrokeThickness="2.2"
                                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" Stretch="None"/>
                                            </Grid>
                                        </Viewbox>
                                    </Border>
                                    <Border Margin="2,0" Padding="4,3" CornerRadius="5"
                                            Background="#49361D" BorderBrush="#8FF3B562" BorderThickness="1"
                                            ToolTip="{DynamicResource Lang_Status_AudioMuted}">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsOutputMuted}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Path Data="{StaticResource IconHeadsetOff}" Fill="#FFD18A" Width="15" Height="15" Stretch="Uniform"/>
                                    </Border>
                                    <Grid Margin="3,0,2,0" ToolTip="Away">
                                        <Grid.Style>
                                            <Style TargetType="Grid">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsAway}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Grid.Style>
                                        <Path Data="{StaticResource IconAway}" Fill="#899CFF" Width="14" Height="14" Stretch="Uniform"/>
                                    </Grid>
                                </StackPanel>
                            </Grid>
                        </Grid>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsTalking}" Value="True">
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="TalkingSurface" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.22"/>
                                            <DoubleAnimation Storyboard.TargetName="VoiceMeter" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.20"/>
                                            <DoubleAnimation Storyboard.TargetName="MeterOnA" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.20"/>
                                            <DoubleAnimation Storyboard.TargetName="MeterOnB" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.24"/>
                                            <DoubleAnimation Storyboard.TargetName="MeterOnC" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.28"/>
                                            <DoubleAnimation Storyboard.TargetName="SpeakingRing" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.22"/>
                                            <DoubleAnimation Storyboard.TargetName="AvatarGlow" Storyboard.TargetProperty="Opacity" To="0.82" Duration="0:0:0.24"/>
                                            <DoubleAnimation Storyboard.TargetName="AvatarGlow" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.24"/>
                                            <DoubleAnimation Storyboard.TargetName="AvatarGlow" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.24"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.EnterActions>
                                <DataTrigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="TalkingSurface" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.18"/>
                                            <DoubleAnimation Storyboard.TargetName="VoiceMeter" Storyboard.TargetProperty="Opacity" To="0.28" Duration="0:0:0.18"/>
                                            <DoubleAnimation Storyboard.TargetName="MeterOnA" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.18"/>
                                            <DoubleAnimation Storyboard.TargetName="MeterOnB" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.18"/>
                                            <DoubleAnimation Storyboard.TargetName="MeterOnC" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.18"/>
                                            <DoubleAnimation Storyboard.TargetName="SpeakingRing" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.18"/>
                                            <DoubleAnimation Storyboard.TargetName="AvatarGlow" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.18"/>
                                            <DoubleAnimation Storyboard.TargetName="AvatarGlow" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="0.86" Duration="0:0:0.18"/>
                                            <DoubleAnimation Storyboard.TargetName="AvatarGlow" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="0.86" Duration="0:0:0.18"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.ExitActions>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding DataContext.Config.AvatarDisplayMode, RelativeSource={RelativeSource AncestorType=Window}}" Value="Indicator">
                                <Setter TargetName="AvatarImage" Property="Visibility" Value="Collapsed"/>
                                <Setter TargetName="Initials" Property="Visibility" Value="Collapsed"/>
                                <Setter TargetName="AvatarBackground" Property="Background" Value="#657386"/>
                            </DataTrigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding DataContext.Config.AvatarDisplayMode, RelativeSource={RelativeSource AncestorType=Window}}" Value="Indicator"/>
                                    <Condition Binding="{Binding IsTalking}" Value="True"/>
                                </MultiDataTrigger.Conditions>
                                <Setter TargetName="AvatarBackground" Property="Background" Value="{Binding DataContext.Config.TalkingBrush, RelativeSource={RelativeSource AncestorType=Window}}"/>
                            </MultiDataTrigger>
                            <DataTrigger Binding="{Binding DataContext.Config.AvatarDisplayMode, RelativeSource={RelativeSource AncestorType=Window}}" Value="AvatarOnly">
                                <Setter TargetName="RowContent" Property="Margin" Value="3"/>
                                <Setter TargetName="RowSurface" Property="Background" Value="Transparent"/>
                                <Setter TargetName="RowSurface" Property="BorderBrush" Value="Transparent"/>
                                <Setter TargetName="TalkingSurface" Property="Visibility" Value="Collapsed"/>
                                <Setter TargetName="VoiceColumn" Property="Width" Value="0"/>
                                <Setter TargetName="NameColumn" Property="Width" Value="0"/>
                                <Setter TargetName="StatusColumn" Property="Width" Value="0"/>
                                <Setter TargetName="VoiceMeter" Property="Visibility" Value="Collapsed"/>
                                <Setter TargetName="UserName" Property="Visibility" Value="Collapsed"/>
                                <Setter TargetName="StatusPanel" Property="Visibility" Value="Collapsed"/>
                                <Setter TargetName="AvatarContainer" Property="Margin" Value="0"/>
                                <Setter TargetName="SpeakingRing" Property="BorderThickness" Value="3"/>
                                <Setter TargetName="AvatarGlow" Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding DataContext.Config.AvatarDisplayMode, RelativeSource={RelativeSource AncestorType=Window}}" Value="AvatarOnly"/>
                                    <Condition Binding="{Binding IsInputMuted}" Value="True"/>
                                </MultiDataTrigger.Conditions>
                                <Setter TargetName="AvatarMicBadge" Property="Visibility" Value="Visible"/>
                            </MultiDataTrigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding DataContext.Config.AvatarDisplayMode, RelativeSource={RelativeSource AncestorType=Window}}" Value="AvatarOnly"/>
                                    <Condition Binding="{Binding IsOutputMuted}" Value="True"/>
                                </MultiDataTrigger.Conditions>
                                <Setter TargetName="AvatarAudioBadge" Property="Visibility" Value="Visible"/>
                            </MultiDataTrigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding DataContext.Config.ShowOnlyTalking, RelativeSource={RelativeSource AncestorType=Window}}" Value="True"/>
                                    <Condition Binding="{Binding IsTalkerVisible}" Value="False"/>
                                </MultiDataTrigger.Conditions>
                                <Setter TargetName="UserRow" Property="Visibility" Value="Collapsed"/>
                            </MultiDataTrigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding DataContext.Config.ShowOnlyTalking, RelativeSource={RelativeSource AncestorType=Window}}" Value="True"/>
                                    <Condition Binding="{Binding IsTalking}" Value="False"/>
                                </MultiDataTrigger.Conditions>
                                <MultiDataTrigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="UserRow" Storyboard.TargetProperty="Opacity"
                                                             To="0" Duration="0:0:0.18"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </MultiDataTrigger.EnterActions>
                                <MultiDataTrigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="UserRow" Storyboard.TargetProperty="Opacity"
                                                             To="1" Duration="0:0:0.16"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </MultiDataTrigger.ExitActions>
                            </MultiDataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Border HorizontalAlignment="Center" VerticalAlignment="Top" Margin="12,14"
                    Background="#F214272E" BorderBrush="#46636A" BorderThickness="1"
                    CornerRadius="12" Padding="11,6">
                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ConnectionStatus}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="6" Height="6" Fill="{StaticResource AmberBrush}" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding ConnectionStatus}" Foreground="#E3F0F0" FontSize="12"
                               FontWeight="Medium" Margin="8,0,0,0" MaxWidth="238" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <Border x:Name="DragFrame" IsHitTestVisible="False" Background="#1219B889"
                    BorderBrush="#7719B889" BorderThickness="1" CornerRadius="10" Margin="4">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Opacity" Value="0"/>
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Window}}" Value="True"/>
                                    <Condition Binding="{Binding IsOverlayLocked}" Value="False"/>
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Opacity" Value="1"/>
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Polyline Points="126,300 136,300 142,286 149,314 157,292 164,307 171,300 183,300"
                              Stroke="#6651E0A1" StrokeThickness="2" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8,4"
                    Background="#F20E1621" BorderBrush="#7351E0A1" BorderThickness="1"
                    CornerRadius="7" Padding="10,6" Cursor="SizeAll">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding Config.ShowOnlyTalking}" Value="True"/>
                                    <Condition Binding="{Binding IsOverlayLocked}" Value="False"/>
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Visible"/>
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="✥" Foreground="{StaticResource VoiceBrush}" FontSize="12" VerticalAlignment="Center"/>
                    <TextBlock Text="{DynamicResource Lang_PositionOverlay}" Foreground="#D8E2EF" FontSize="11"
                               FontWeight="Medium" Margin="7,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="2" HorizontalAlignment="Center" Background="#F20E1621"
                BorderBrush="#3C4D63" BorderThickness="1" CornerRadius="6"
                Padding="10,5" Margin="10,8">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsOverlayLocked}" Value="False"/>
                                <Condition Binding="{Binding Config.ShowOnlyTalking}" Value="False"/>
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Visibility" Value="Visible"/>
                        </MultiDataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="✥" Foreground="{StaticResource VoiceBrush}" FontSize="12" VerticalAlignment="Center"/>
                <TextBlock Text="{DynamicResource Lang_Unlocked}" Foreground="#B7C3D2" FontSize="11"
                           FontWeight="Medium" Margin="7,0,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
