<Window x:Class="TS6_SpeakerOverlay.Views.LogViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Lang_LogViewer_Title}"
        Width="860" Height="610" MinWidth="680" MinHeight="460"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" ResizeMode="CanResizeWithGrip"
        Background="#F2F7F7"
        FontFamily="Microsoft YaHei UI, Segoe UI Variable Text, Segoe UI">
    <Window.Resources>
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="15,0"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#16323A"/>
            <Setter Property="BorderBrush" Value="#D6E4E6"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Shell" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Shell" Property="BorderBrush" Value="#19B889"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Shell" Property="BorderBrush" Value="#19B889"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Border BorderBrush="#C8DADC" BorderThickness="1" CornerRadius="16" Background="#F2F7F7">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="76"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="52"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" Margin="26,0,20,0" MouseDown="TitleBar_MouseDown">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="40"/></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{DynamicResource Lang_LogViewer_Title}" FontFamily="Segoe UI Variable Display, Microsoft YaHei UI"
                               FontSize="23" FontWeight="SemiBold" Foreground="#16323A"/>
                    <TextBlock Text="{DynamicResource Lang_LogViewer_Subtitle}" FontSize="12"
                               Foreground="#657C84" Margin="0,3,0,0"/>
                </StackPanel>
                <Button Grid.Column="1" Content="×" FontSize="23" Background="Transparent"
                        Foreground="#657C84" BorderThickness="0" Cursor="Hand" Click="Close_Click"/>
            </Grid>
            <Grid Grid.Row="1" Margin="26,0,18,18">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="AllButton" Content="{DynamicResource Lang_LogViewer_All}"
                            Style="{StaticResource ActionButton}" Click="All_Click"/>
                    <Button x:Name="ErrorsButton" Content="{DynamicResource Lang_LogViewer_Errors}"
                            Style="{StaticResource ActionButton}" Click="Errors_Click"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Content="{DynamicResource Lang_LogViewer_Refresh}" Style="{StaticResource ActionButton}" Click="Refresh_Click"/>
                    <Button Content="{DynamicResource Lang_LogViewer_Copy}" Style="{StaticResource ActionButton}" Click="Copy_Click"/>
                    <Button Content="{DynamicResource Lang_Tray_OpenLogs}" Style="{StaticResource ActionButton}" Click="OpenFolder_Click"/>
                </StackPanel>
            </Grid>
            <Border Grid.Row="2" Margin="26,0,26,0" Background="#FFFFFF" BorderBrush="#D6E4E6"
                    BorderThickness="1" CornerRadius="12">
                <TextBox x:Name="LogTextBox" Margin="15" BorderThickness="0" Background="Transparent"
                         Foreground="#24434B" FontFamily="Cascadia Mono, Consolas" FontSize="12"
                         IsReadOnly="True" TextWrapping="NoWrap"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
            </Border>
            <TextBlock x:Name="StatusText" Grid.Row="3" Margin="27,0" VerticalAlignment="Center"
                       Foreground="#657C84" FontSize="12"/>
        </Grid>
    </Border>
</Window>
