<Window x:Class="TS6_SpeakerOverlay.Views.LogViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Lang_LogViewer_Title}"
        Width="860" Height="610" MinWidth="680" MinHeight="460"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" ResizeMode="CanResizeWithGrip"
        Background="{DynamicResource SurfaceBrush}"
        FontFamily="{DynamicResource UtilityFont}" FontSize="13"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Resources/Styles/UtilityWindowTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="ActionButton" TargetType="Button" BasedOn="{StaticResource QuietButton}">
                <Setter Property="Margin" Value="0,0,8,8"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>
    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="16" Background="{StaticResource SurfaceBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="64"/><RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/><RowDefinition Height="48"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" Margin="24,0" MouseDown="TitleBar_MouseDown">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="40"/></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{DynamicResource Lang_LogViewer_Title}" Style="{StaticResource SectionTitle}"/>
                    <TextBlock Text="{DynamicResource Lang_LogViewer_Subtitle}" Style="{StaticResource SectionDescription}" Margin="0,4,0,0"/>
                </StackPanel>
                <Button Grid.Column="1" Content="×" Style="{StaticResource CloseButton}" VerticalAlignment="Center" Click="Close_Click"/>
            </Grid>
            <WrapPanel x:Name="LogActions" Grid.Row="1" Margin="24,8,16,8">
                <Button x:Name="AllButton" Content="{DynamicResource Lang_LogViewer_All}" Style="{StaticResource ActionButton}" Click="All_Click"/>
                <Button x:Name="ErrorsButton" Content="{DynamicResource Lang_LogViewer_Errors}" Style="{StaticResource ActionButton}" Click="Errors_Click"/>
                <Button Content="{DynamicResource Lang_LogViewer_Refresh}" Style="{StaticResource ActionButton}" Click="Refresh_Click"/>
                <Button Content="{DynamicResource Lang_LogViewer_Copy}" Style="{StaticResource ActionButton}" Click="Copy_Click"/>
                <Button Content="{DynamicResource Lang_Tray_OpenLogs}" Style="{StaticResource ActionButton}" Click="OpenFolder_Click"/>
            </WrapPanel>
            <Border Grid.Row="2" Margin="24,0" Background="{StaticResource SurfaceRaisedBrush}" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" CornerRadius="8">
                <TextBox x:Name="LogTextBox" Margin="16" BorderThickness="0" Background="Transparent"
                         Foreground="{StaticResource TextBrush}" FontFamily="Cascadia Mono, Consolas" FontSize="12"
                         IsReadOnly="True" TextWrapping="NoWrap"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
            </Border>
            <TextBlock x:Name="StatusText" Grid.Row="3" Margin="24,0" VerticalAlignment="Center"
                       Foreground="{StaticResource MutedBrush}" FontSize="12" TextWrapping="Wrap"/>
        </Grid>
    </Border>
</Window>
