<Window x:Class="TS6_SpeakerOverlay.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:TS6_SpeakerOverlay.Models"
        xmlns:helpers="clr-namespace:TS6_SpeakerOverlay.Helpers"
        Title="{DynamicResource Lang_Settings_Title}"
        Width="960" Height="720"
        MinWidth="880" MinHeight="660"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterOwner"
        FontFamily="{DynamicResource UtilityFont}"
        FontSize="13"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Resources/Styles/UtilityWindowTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        <helpers:PresetSelectionConverter x:Key="PresetSelectionConverter"/>

        <Style TargetType="{x:Type ScrollBar}">
            <Setter Property="Width" Value="10"/>
            <Setter Property="Background" Value="#F6F8F7"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Width="10" Background="{TemplateBinding Background}">
                            <Track x:Name="PART_Track" Orientation="Vertical" IsDirectionReversed="True"
                                   Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}"
                                   Value="{TemplateBinding Value}" ViewportSize="{TemplateBinding ViewportSize}">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Width="4" Margin="3,2" Background="#9EBBBA" CornerRadius="2"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        </Style>





        <Style x:Key="ThinSlider" TargetType="Slider">
            <Setter Property="Height" Value="24"/>
            <Setter Property="Focusable" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Background="Transparent">
                            <Border Height="4" CornerRadius="2" Background="#D5E0D9" VerticalAlignment="Center"/>
                            <Track x:Name="PART_Track" VerticalAlignment="Center">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="4" CornerRadius="2" Background="{StaticResource AccentBrush}"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="14" Height="14">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border x:Name="Dot" CornerRadius="7" Background="#FFFFFF" BorderBrush="{StaticResource AccentBrush}" BorderThickness="3"/>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Dot" Property="Background" Value="{StaticResource AccentHoverBrush}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" Background="Transparent" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <ControlTemplate x:Key="ComboToggleTemplate" TargetType="ToggleButton">
            <Border x:Name="Shell" Background="#FFFFFF" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="34"/></Grid.ColumnDefinitions>
                    <ContentPresenter Margin="12,0,6,0" VerticalAlignment="Center" HorizontalAlignment="Left"
                                      TextElement.Foreground="{StaticResource TextBrush}"/>
                    <Path Grid.Column="1" Width="8" Height="5" Stretch="Fill" Fill="{StaticResource MutedBrush}"
                          Data="M 0 0 L 4 4 L 8 0 Z" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Shell" Property="BorderBrush" Value="#71A99D"/></Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Shell" Property="BorderBrush" Value="{StaticResource AccentBrush}"/></Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <Style x:Key="ModernComboBoxItem" TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBorder" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="#E4F3EE"/></Trigger>
                            <Trigger Property="IsSelected" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="#CDECE0"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernComboBox" TargetType="ComboBox">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource ModernComboBoxItem}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton" Template="{StaticResource ComboToggleTemplate}"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                          ClickMode="Press"/>
                            <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom"
                                   AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                                <Border Margin="0,4,0,0" MinWidth="{Binding ActualWidth, ElementName=ToggleButton}"
                                        Padding="5" Background="#FFFFFF" BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1" CornerRadius="9">
                                    <ScrollViewer MaxHeight="240" CanContentScroll="True">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ToggleSwitch" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Background="Transparent" MinHeight="36">
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="44"/></Grid.ColumnDefinitions>
                            <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="True"/>
                            <Border x:Name="Track" Grid.Column="1" Width="38" Height="22" Background="#C8D7CF" CornerRadius="11" HorizontalAlignment="Right">
                                <Ellipse x:Name="Knob" Width="16" Height="16" Fill="#FFFFFF" HorizontalAlignment="Left" Margin="3"/>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="Knob" Property="Fill" Value="#F1F5F3"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Track" Property="Opacity" Value="0.9"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>


        <Style x:Key="PositionPresetButton" TargetType="Button" BasedOn="{StaticResource QuietButton}">
            <Setter Property="Width" Value="48"/><Setter Property="Height" Value="36"/>
            <Setter Property="Margin" Value="3"/><Setter Property="Padding" Value="0"/>
            <Setter Property="FontFamily" Value="Segoe UI Symbol"/><Setter Property="FontSize" Value="19"/>
            <Setter Property="FontWeight" Value="Normal"/><Setter Property="Background" Value="#FFFFFF"/>
            <Style.Triggers>
                <DataTrigger Value="True">
                    <DataTrigger.Binding>
                        <MultiBinding Converter="{StaticResource PresetSelectionConverter}">
                            <Binding Path="Config.PositionPreset"/><Binding Path="Tag" RelativeSource="{RelativeSource Self}"/>
                        </MultiBinding>
                    </DataTrigger.Binding>
                    <Setter Property="Background" Value="#E4F1EB"/><Setter Property="BorderBrush" Value="#19B889"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>


        <Style x:Key="ColorSwatchButton" TargetType="Button">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="SwatchBorder" CornerRadius="9" Background="#F1F5F3" BorderBrush="#B4CDCE" BorderThickness="1">
                            <Ellipse Width="18" Height="18" Fill="{TemplateBinding Background}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="SwatchBorder" Property="BorderBrush" Value="#16323A"/></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="SwatchBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <BooleanToVisibilityConverter x:Key="BooleanVisibility"/>
        <Style x:Key="CategoryButton" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="3,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="CategoryShell" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="8" Padding="8,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="CategoryShell" Property="Background" Value="#F0F6F5"/></Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CategoryShell" Property="Background" Value="#E4F1EB"/>
                                <Setter Property="Foreground" Value="#147D64"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="CategoryShell" Property="BorderBrush" Value="#147D64"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Border Background="#F6F8F7" BorderBrush="#CFDCD5" BorderThickness="1" CornerRadius="18">
        <Grid ClipToBounds="True">
            <Grid.RowDefinitions>
                <RowDefinition Height="64"/>
                <RowDefinition Height="56"/>
                <RowDefinition Height="48"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="56"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{StaticResource SurfaceRaisedBrush}" CornerRadius="18,18,0,0"
                    BorderBrush="#DDE5E1" BorderThickness="0,0,0,1" MouseDown="TitleBar_MouseDown">
                <Grid Margin="32,0,24,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="42"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="44"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="38" Height="38" Background="#E4F1EB" CornerRadius="11" HorizontalAlignment="Left">
                        <Grid Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Rectangle Width="3" Height="8" RadiusX="1.5" Fill="{StaticResource AccentBrush}" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                            <Rectangle Width="3" Height="16" RadiusX="1.5" Fill="{StaticResource AccentBrush}" HorizontalAlignment="Center"/>
                            <Rectangle Width="3" Height="11" RadiusX="1.5" Fill="{StaticResource VoiceBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="2,0,0,0">
                        <TextBlock Text="{DynamicResource Lang_Settings_Title}" FontFamily="Segoe UI Variable Display, Microsoft YaHei UI, Segoe UI" FontSize="20" FontWeight="SemiBold"/>
                        <TextBlock Text="{DynamicResource Lang_Settings_Subtitle}" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,4,0,0"/>
                    </StackPanel>
                    <Border Grid.Column="2" Background="#E5F0F0" CornerRadius="12" Padding="10,5" VerticalAlignment="Center" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="ConnectionDot" Width="7" Height="7" VerticalAlignment="Center" Margin="0,0,7,0">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="#83979B"/>
                                        <Style.Triggers><DataTrigger Binding="{Binding IsConnected}" Value="True"><Setter Property="Fill" Value="{StaticResource VoiceBrush}"/></DataTrigger></Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock FontSize="12" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                        <Setter Property="Text" Value="{DynamicResource Lang_Status_Waiting}"/>
                                        <Style.Triggers><DataTrigger Binding="{Binding IsConnected}" Value="True"><Setter Property="Text" Value="{DynamicResource Lang_Status_Connected}"/></DataTrigger></Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                    <Button Grid.Column="3" Content="×" Style="{StaticResource CloseButton}"
                            Click="BtnClose_Click" ToolTip="Close" VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <Border Grid.Row="1" Background="#F1F5F3" BorderBrush="#DDE5E1" BorderThickness="0,0,0,1">
                <Grid Margin="32,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="220"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,18,0">
                        <Viewbox Width="20" Height="20" Margin="0,0,10,0">
                            <Canvas Width="24" Height="24">
                                <Ellipse Width="20" Height="20" Canvas.Left="2" Canvas.Top="2" Stroke="#238D75" StrokeThickness="1.5"/>
                                <Ellipse Width="8" Height="20" Canvas.Left="8" Canvas.Top="2" Stroke="#238D75" StrokeThickness="1.5"/>
                                <Path Data="M2,12 H22 M4,6.5 H20 M4,17.5 H20" Stroke="#238D75" StrokeThickness="1.3"/>
                            </Canvas>
                        </Viewbox>
                        <TextBlock Text="Language / 语言" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                    <ComboBox x:Name="LanguageSelector" Grid.Column="1" Style="{StaticResource ModernComboBox}"
                              VerticalAlignment="Center" ItemsSource="{x:Static helpers:LanguageHelper.SupportedLanguages}"
                              DisplayMemberPath="NativeName" SelectedValuePath="Code"
                              SelectedValue="{Binding Config.Language, Mode=TwoWay}"
                              AutomationProperties.Name="Language / 语言 / 한국어 / Deutsch / Español / Français / Русский"
                              SelectionChanged="LanguageComboBox_SelectionChanged"/>
                    <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="12,0">
                        <TextBlock Text="{Binding CurrentVersion, StringFormat=v{0}}" FontSize="12" HorizontalAlignment="Right"
                                   Foreground="{StaticResource MutedBrush}"/>
                        <TextBlock Text="{Binding UpdateStatusText}" FontSize="12" MaxWidth="240" TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding UpdateStatusText}" Foreground="#147D64" Margin="0,4,0,0"/>
                    </StackPanel>
                    <Button Grid.Column="3" ToolTip="{Binding UpdateStatusText}" VerticalAlignment="Center">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource QuietButton}">
                                <Setter Property="Content" Value="{DynamicResource Lang_Update_Check}"/>
                                <Setter Property="Command" Value="{Binding CheckForUpdatesCommand}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsUpdateAvailable}" Value="True">
                                        <Setter Property="Content" Value="{DynamicResource Lang_Update_Download}"/>
                                        <Setter Property="Command" Value="{Binding OpenUpdateCommand}"/>
                                        <Setter Property="Background" Value="#E4F1EB"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>
            </Border>

            <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="#DDE5E1" BorderThickness="0,0,0,1">
                <UniformGrid Rows="1" Margin="20,7">
                    <RadioButton x:Name="NavDisplay" GroupName="SettingsCategories" Style="{StaticResource CategoryButton}" IsChecked="True" Content="{DynamicResource Lang_Settings_Display}" AutomationProperties.Name="{DynamicResource Lang_Settings_Display}"/>
                    <RadioButton x:Name="NavPosition" GroupName="SettingsCategories" Style="{StaticResource CategoryButton}" Content="{DynamicResource Lang_Settings_Position}" AutomationProperties.Name="{DynamicResource Lang_Settings_Position}"/>
                    <RadioButton x:Name="NavNotifications" GroupName="SettingsCategories" Style="{StaticResource CategoryButton}" Content="{DynamicResource Lang_Settings_Notifications}" AutomationProperties.Name="{DynamicResource Lang_Settings_Notifications}"/>
                    <RadioButton x:Name="NavConnection" GroupName="SettingsCategories" Style="{StaticResource CategoryButton}" Content="{DynamicResource Lang_Settings_Connection}" AutomationProperties.Name="{DynamicResource Lang_Settings_Connection}"/>
                    <RadioButton x:Name="NavApplication" GroupName="SettingsCategories" Style="{StaticResource CategoryButton}" Content="{DynamicResource Lang_Settings_Application}" AutomationProperties.Name="{DynamicResource Lang_Settings_Application}"/>
                </UniformGrid>
            </Border>
            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="1"/>
                    <ColumnDefinition Width="280"/>
                </Grid.ColumnDefinitions>
                <ScrollViewer x:Name="SettingsScroller" Grid.Column="0" Background="#FFFFFF"
                    VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                    Visibility="{Binding IsChecked, ElementName=NavDisplay, Converter={StaticResource BooleanVisibility}}">
                    <StackPanel x:Name="DisplaySettings" Margin="32,24,32,24">
                        <TextBlock Text="{DynamicResource Lang_Appearance}" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="{DynamicResource Lang_Appearance_Description}" Style="{StaticResource SectionDescription}" Margin="0,4,0,16"/>
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="225"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,24,0">
                                <TextBlock Text="{DynamicResource Lang_AvatarMode}" Style="{StaticResource SettingLabel}"/>
                                <TextBlock Text="{DynamicResource Lang_AvatarMode_Description}" Style="{StaticResource SectionDescription}" Margin="0,4,0,0"/>
                            </StackPanel>
                            <ComboBox Grid.Column="1" Style="{StaticResource ModernComboBox}"
                                SelectedValuePath="Tag" SelectedValue="{Binding Config.AvatarDisplayMode, Mode=TwoWay}">
                                <ComboBoxItem Content="{DynamicResource Lang_Mode_Avatar}" Tag="{x:Static models:AvatarMode.Avatar}"/>
                                <ComboBoxItem Content="{DynamicResource Lang_Mode_AvatarOnly}" Tag="{x:Static models:AvatarMode.AvatarOnly}"/>
                                <ComboBoxItem Content="{DynamicResource Lang_Mode_Indicator}" Tag="{x:Static models:AvatarMode.Indicator}"/>
                                <ComboBoxItem Content="{DynamicResource Lang_Mode_None}" Tag="{x:Static models:AvatarMode.None}"/>
                            </ComboBox>
                        </Grid>
                        <StackPanel Margin="0,0,0,16">
                            <CheckBox Style="{StaticResource ToggleSwitch}"
                                IsChecked="{Binding Config.ShowOnlyTalking, Mode=TwoWay}">
                                <TextBlock Text="{DynamicResource Lang_ShowOnlyTalking}" TextWrapping="Wrap" Margin="0,0,10,0"/>
                            </CheckBox>
                            <TextBlock Text="{DynamicResource Lang_ShowOnlyTalking_Description}"
                                Style="{StaticResource SectionDescription}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                        </StackPanel>
                        <Border Height="1" Background="#DDE5E1" Margin="0,0,0,16"/>
                        <StackPanel Margin="0,0,0,16">
                            <Grid>
                                <TextBlock Text="{DynamicResource Lang_TalkingColor}" Style="{StaticResource SettingLabel}"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Ellipse Width="12" Height="12" Fill="{Binding Config.TalkingBrush}" VerticalAlignment="Center" Margin="0,0,7,0"/>
                                    <TextBlock Text="{Binding Config.TalkingColor}" Style="{StaticResource ValueLabel}"/>
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="{DynamicResource Lang_TalkingColor_Description}" Style="{StaticResource SectionDescription}" Margin="0,4,0,8"/>
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource ColorSwatchButton}" Background="#19B889" Tag="#19B889" ToolTip="Mint" Click="TalkingColorPreset_Click"/>
                                <Button Style="{StaticResource ColorSwatchButton}" Background="#58BEFF" Tag="#58BEFF" ToolTip="Sky" Click="TalkingColorPreset_Click"/>
                                <Button Style="{StaticResource ColorSwatchButton}" Background="#B49AFF" Tag="#B49AFF" ToolTip="Violet" Click="TalkingColorPreset_Click"/>
                                <Button Style="{StaticResource ColorSwatchButton}" Background="#FFBF69" Tag="#FFBF69" ToolTip="Amber" Click="TalkingColorPreset_Click"/>
                                <Button Style="{StaticResource ColorSwatchButton}" Background="#FF85A6" Tag="#FF85A6" ToolTip="Rose" Click="TalkingColorPreset_Click"/>
                                <Button Style="{StaticResource ColorSwatchButton}" Background="#F0F5FF" Tag="#F0F5FF" ToolTip="Ice" Click="TalkingColorPreset_Click"/>
                                <Button Content="{DynamicResource Lang_TalkingColor_Custom}" Style="{StaticResource QuietButton}" Height="32" Padding="12,0" Click="TalkingColorCustom_Click"/>
                            </StackPanel>
                        </StackPanel>
                        <Border Height="1" Background="#DDE5E1" Margin="0,0,0,16"/>
                        <StackPanel Margin="0,0,0,20">
                            <TextBlock Text="{DynamicResource Lang_NameFont_Title}" Style="{StaticResource SettingLabel}"/>
                            <TextBlock Text="{DynamicResource Lang_NameFont_Description}" Style="{StaticResource SectionDescription}" Margin="0,4,0,12"/>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition Width="96"/></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="220"/><ColumnDefinition Width="8"/><ColumnDefinition Width="28"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="{DynamicResource Lang_NameFont_Family}" Style="{StaticResource SettingLabel}" VerticalAlignment="Center"/>
                                    <Grid Grid.Column="2">
                                        <TextBox x:Name="NameFontSearchInput" Style="{StaticResource TextInput}" Height="28" FontSize="12" Padding="8,0"
                                                 Text="{Binding NameFontSearch, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 ToolTip="{DynamicResource Lang_NameFont_Search}" AutomationProperties.Name="{DynamicResource Lang_NameFont_Search}"/>
                                        <TextBlock Text="{DynamicResource Lang_NameFont_Search}" Margin="8,0" VerticalAlignment="Center"
                                                   Foreground="{StaticResource MutedBrush}" FontSize="12" TextTrimming="CharacterEllipsis" IsHitTestVisible="False">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers><DataTrigger Binding="{Binding NameFontSearch}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                    <Button Grid.Column="4" Content="×" Height="28" Command="{Binding ClearNameFontSearchCommand}"
                                            ToolTip="{DynamicResource Lang_NameFont_ClearSearch}" AutomationProperties.Name="{DynamicResource Lang_NameFont_ClearSearch}">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource QuietButton}">
                                                <Setter Property="Padding" Value="0"/><Setter Property="FontSize" Value="18"/>
                                                <Style.Triggers><DataTrigger Binding="{Binding NameFontSearch}" Value=""><Setter Property="IsEnabled" Value="False"/></DataTrigger></Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </Grid>
                                <TextBlock Grid.Column="2" Text="{DynamicResource Lang_FontSize}" Style="{StaticResource SettingLabel}" VerticalAlignment="Center" Margin="0,0,0,8"/>
                                <ComboBox x:Name="NameFontSelector" Grid.Row="1" Style="{StaticResource ModernComboBox}"
                                          Height="36" ItemsSource="{Binding NameFonts}" DisplayMemberPath="DisplayName" SelectedValuePath="FamilyName"
                                          SelectedValue="{Binding Config.NameFontFamily, Mode=TwoWay}" IsTextSearchEnabled="True"
                                          AutomationProperties.Name="{DynamicResource Lang_NameFont_Family}"/>
                                <TextBox x:Name="NameFontSizeInput" Grid.Row="1" Grid.Column="2" Style="{StaticResource TextInput}"
                                         ToolTip="{DynamicResource Lang_NameFont_Range}" AutomationProperties.Name="{DynamicResource Lang_FontSize}">
                                    <TextBox.Text>
                                        <Binding Path="Config.FontSize" Mode="TwoWay" UpdateSourceTrigger="LostFocus" ValidatesOnExceptions="True" StringFormat="{}{0:0.#}">
                                            <Binding.ValidationRules><helpers:NameFontSizeValidationRule/></Binding.ValidationRules>
                                        </Binding>
                                    </TextBox.Text>
                                </TextBox>
                            </Grid>
                            <TextBlock Text="{DynamicResource Lang_NameFont_NoMatches}" Style="{StaticResource SectionDescription}" Margin="0,8,0,0"
                                       Visibility="{Binding HasNoNameFontMatches, Converter={StaticResource BooleanVisibility}}"/>
                            <Slider Style="{StaticResource ThinSlider}" Minimum="10" Maximum="36" TickFrequency="1" IsSnapToTickEnabled="True"
                                    Value="{Binding Config.FontSize, Mode=TwoWay}" Margin="0,8,0,0"/>
                        </StackPanel>
                        <StackPanel>
                            <Grid>
                                <TextBlock Text="{DynamicResource Lang_AvatarSize}" Style="{StaticResource SettingLabel}"/>
                                <TextBlock Text="{Binding Config.AvatarSize, StringFormat={}{0:0} px}" Style="{StaticResource ValueLabel}"/>
                            </Grid>
                            <Slider Style="{StaticResource ThinSlider}" Minimum="14" Maximum="38" TickFrequency="1" IsSnapToTickEnabled="True"
                                    Value="{Binding Config.AvatarSize, Mode=TwoWay}" Margin="0,8,0,0"/>
                        </StackPanel>
                        <StackPanel Margin="0,20,0,0">
                            <Grid>
                                <TextBlock Text="{DynamicResource Lang_Opacity}" Style="{StaticResource SettingLabel}"/>
                                <TextBlock Text="{Binding Config.BackgroundOpacity, StringFormat={}{0:P0}}" Style="{StaticResource ValueLabel}"/>
                            </Grid>
                            <Slider Style="{StaticResource ThinSlider}" Minimum="0.15" Maximum="1" TickFrequency="0.05" IsSnapToTickEnabled="True" Value="{Binding Config.BackgroundOpacity, Mode=TwoWay}" Margin="0,8,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
                <ScrollViewer x:Name="PositionScroller" Grid.Column="0" Background="#FFFFFF"
                    VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                    Visibility="{Binding IsChecked, ElementName=NavPosition, Converter={StaticResource BooleanVisibility}}">
                    <StackPanel x:Name="PositionSettings" Margin="32,24,32,24">
                        <TextBlock Text="{DynamicResource Lang_Position_Title}" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="{DynamicResource Lang_Position_Description}" Style="{StaticResource SectionDescription}" Margin="0,5,0,18"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="24"/>
                                <ColumnDefinition Width="182"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Lang_Position_Alignment}" Style="{StaticResource SettingLabel}" Margin="0,0,0,8"/>
                                <ComboBox Style="{StaticResource ModernComboBox}" SelectedValuePath="Tag" SelectedValue="{Binding Config.UserListAlignment, Mode=TwoWay}">
                                    <ComboBoxItem Content="{DynamicResource Lang_Position_Top}" Tag="{x:Static VerticalAlignment.Top}"/>
                                    <ComboBoxItem Content="{DynamicResource Lang_Position_Center}" Tag="{x:Static VerticalAlignment.Center}"/>
                                    <ComboBoxItem Content="{DynamicResource Lang_Position_Bottom}" Tag="{x:Static VerticalAlignment.Bottom}"/>
                                </ComboBox>
                                <Grid Margin="0,17,0,0">
                                    <TextBlock Text="{DynamicResource Lang_Position_Gap}" Style="{StaticResource SettingLabel}"/>
                                    <TextBlock Text="{Binding Config.ScreenEdgeGap, StringFormat={}{0:0} px}" Style="{StaticResource ValueLabel}"/>
                                </Grid>
                                <Slider Style="{StaticResource ThinSlider}" Minimum="0" Maximum="80" TickFrequency="1" IsSnapToTickEnabled="True"
                                    Value="{Binding Config.ScreenEdgeGap, Mode=TwoWay}" Margin="0,7,0,12"/>
                                <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding Config.SnapToScreenEdges, Mode=TwoWay}">
                                    <TextBlock Text="{DynamicResource Lang_Position_Snap}" TextWrapping="Wrap"/>
                                </CheckBox>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="{DynamicResource Lang_Position_Quick}" Style="{StaticResource SettingLabel}" Margin="0,0,0,8"/>
                                <Border BorderBrush="#C6DCDD" BorderThickness="1" CornerRadius="10" Padding="6" Background="#F6F8F7">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition/>
                                            <RowDefinition/>
                                            <RowDefinition/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition/>
                                            <ColumnDefinition/>
                                            <ColumnDefinition/>
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Row="0" Grid.Column="0" Content="↖" Style="{StaticResource PositionPresetButton}"
                                            Tag="{x:Static models:OverlayPosition.TopLeft}" Command="{Binding MoveOverlayCommand}"
                                            CommandParameter="{x:Static models:OverlayPosition.TopLeft}" ToolTip="{DynamicResource Lang_Position_TopLeft}"
                                            AutomationProperties.Name="{DynamicResource Lang_Position_TopLeft}"/>
                                        <Button Grid.Row="0" Grid.Column="1" Content="↑" Style="{StaticResource PositionPresetButton}"
                                            Tag="{x:Static models:OverlayPosition.TopCenter}" Command="{Binding MoveOverlayCommand}"
                                            CommandParameter="{x:Static models:OverlayPosition.TopCenter}" ToolTip="{DynamicResource Lang_Position_TopCenter}"
                                            AutomationProperties.Name="{DynamicResource Lang_Position_TopCenter}"/>
                                        <Button Grid.Row="0" Grid.Column="2" Content="↗" Style="{StaticResource PositionPresetButton}"
                                            Tag="{x:Static models:OverlayPosition.TopRight}" Command="{Binding MoveOverlayCommand}"
                                            CommandParameter="{x:Static models:OverlayPosition.TopRight}" ToolTip="{DynamicResource Lang_Position_TopRight}"
                                            AutomationProperties.Name="{DynamicResource Lang_Position_TopRight}"/>
                                        <Button Grid.Row="1" Grid.Column="0" Content="←" Style="{StaticResource PositionPresetButton}"
                                            Tag="{x:Static models:OverlayPosition.CenterLeft}" Command="{Binding MoveOverlayCommand}"
                                            CommandParameter="{x:Static models:OverlayPosition.CenterLeft}" ToolTip="{DynamicResource Lang_Position_CenterLeft}"
                                            AutomationProperties.Name="{DynamicResource Lang_Position_CenterLeft}"/>
                                        <Button Grid.Row="1" Grid.Column="2" Content="→" Style="{StaticResource PositionPresetButton}"
                                            Tag="{x:Static models:OverlayPosition.CenterRight}" Command="{Binding MoveOverlayCommand}"
                                            CommandParameter="{x:Static models:OverlayPosition.CenterRight}" ToolTip="{DynamicResource Lang_Position_CenterRight}"
                                            AutomationProperties.Name="{DynamicResource Lang_Position_CenterRight}"/>
                                        <Button Grid.Row="2" Grid.Column="0" Content="↙" Style="{StaticResource PositionPresetButton}"
                                            Tag="{x:Static models:OverlayPosition.BottomLeft}" Command="{Binding MoveOverlayCommand}"
                                            CommandParameter="{x:Static models:OverlayPosition.BottomLeft}" ToolTip="{DynamicResource Lang_Position_BottomLeft}"
                                            AutomationProperties.Name="{DynamicResource Lang_Position_BottomLeft}"/>
                                        <Button Grid.Row="2" Grid.Column="1" Content="↓" Style="{StaticResource PositionPresetButton}"
                                            Tag="{x:Static models:OverlayPosition.BottomCenter}" Command="{Binding MoveOverlayCommand}"
                                            CommandParameter="{x:Static models:OverlayPosition.BottomCenter}" ToolTip="{DynamicResource Lang_Position_BottomCenter}"
                                            AutomationProperties.Name="{DynamicResource Lang_Position_BottomCenter}"/>
                                        <Button Grid.Row="2" Grid.Column="2" Content="↘" Style="{StaticResource PositionPresetButton}"
                                            Tag="{x:Static models:OverlayPosition.BottomRight}" Command="{Binding MoveOverlayCommand}"
                                            CommandParameter="{x:Static models:OverlayPosition.BottomRight}" ToolTip="{DynamicResource Lang_Position_BottomRight}"
                                            AutomationProperties.Name="{DynamicResource Lang_Position_BottomRight}"/>
                                        <Ellipse Grid.Row="1" Grid.Column="1" Width="6" Height="6" Fill="#A3C2BC" VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False"/>
                                    </Grid>
                                </Border>
                                <TextBlock Text="{DynamicResource Lang_Position_Screen}" Style="{StaticResource SectionDescription}" FontSize="12" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="{DynamicResource Lang_Position_DragHint}" Style="{StaticResource SectionDescription}" Margin="0,14,0,0"/>
                        <Border Height="1" Background="#DDE5E1" Margin="0,24,0,16"/>
                        <StackPanel>
                            <Grid>
                                <TextBlock Text="{DynamicResource Lang_Spacing}" Style="{StaticResource SettingLabel}"/>
                                <TextBlock Text="{Binding Config.ItemSpacing, StringFormat={}{0:0} px}" Style="{StaticResource ValueLabel}"/>
                            </Grid>
                            <Slider Style="{StaticResource ThinSlider}" Minimum="0" Maximum="16" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding Config.ItemSpacing, Mode=TwoWay}" Margin="0,8,0,0"/>
                        </StackPanel>
                        <StackPanel Margin="0,20,0,0">
                            <Grid>
                                <TextBlock Text="{DynamicResource Lang_Scale}" Style="{StaticResource SettingLabel}"/>
                                <TextBlock Text="{Binding Config.UiScale, StringFormat={}{0:P0}}" Style="{StaticResource ValueLabel}"/>
                            </Grid>
                            <Slider Style="{StaticResource ThinSlider}" Minimum="0.65" Maximum="1.5" TickFrequency="0.05" IsSnapToTickEnabled="True" Value="{Binding Config.UiScale, Mode=TwoWay}" Margin="0,8,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
                <ScrollViewer x:Name="NotificationsScroller" Grid.Column="0" Background="#FFFFFF"
                    VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                    Visibility="{Binding IsChecked, ElementName=NavNotifications, Converter={StaticResource BooleanVisibility}}">
                    <StackPanel x:Name="NotificationsSettings" Margin="32,24,32,24">
                        <TextBlock Text="{DynamicResource Lang_Settings_Notifications}" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="{DynamicResource Lang_Settings_NotificationsDescription}" Style="{StaticResource SectionDescription}" Margin="0,4,0,16"/>
                        <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding Config.EnableNotifications, Mode=TwoWay}">
                            <TextBlock Text="{DynamicResource Lang_EnableNotify}" TextWrapping="Wrap" Margin="0,0,10,0"/>
                        </CheckBox>
                        <Border BorderBrush="#BDD8D3" BorderThickness="2,0,0,0" Padding="10,0,0,0" Margin="3,3,0,8">
                            <StackPanel>
                                <CheckBox Style="{StaticResource ToggleSwitch}" Foreground="#48656D" IsChecked="{Binding Config.EnableServerNotifications, Mode=TwoWay}"
                                    IsEnabled="{Binding Config.EnableNotifications}">
                                    <TextBlock Text="{DynamicResource Lang_ServerNotifications}" TextWrapping="Wrap"/>
                                </CheckBox>
                                <CheckBox Style="{StaticResource ToggleSwitch}" Foreground="#48656D" IsChecked="{Binding Config.EnableChannelNotifications, Mode=TwoWay}"
                                    IsEnabled="{Binding Config.EnableNotifications}">
                                    <TextBlock Text="{DynamicResource Lang_ChannelNotifications}" TextWrapping="Wrap"/>
                                </CheckBox>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
                <ScrollViewer x:Name="ConnectionScroller" Grid.Column="0" Background="#FFFFFF"
                    VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                    Visibility="{Binding IsChecked, ElementName=NavConnection, Converter={StaticResource BooleanVisibility}}">
                    <StackPanel x:Name="ConnectionSettings" Margin="32,24,32,24">
                        <TextBlock Text="{DynamicResource Lang_ConnectionSettings}" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="{DynamicResource Lang_ConnectionSettings_Description}" Style="{StaticResource SectionDescription}" Margin="0,4,0,16"/>
                        <StackPanel Margin="0,0,0,24"
                            ToolTip="{DynamicResource Lang_ServerSource_Description}">
                            <TextBlock Text="{DynamicResource Lang_ServerSource}" Foreground="{StaticResource MutedBrush}" Style="{StaticResource SettingLabel}" Margin="0,0,0,8"/>
                            <Grid>
                                <ComboBox Style="{StaticResource ModernComboBox}" AutomationProperties.Name="{DynamicResource Lang_ServerSource}"
                                    ItemsSource="{Binding Servers}"
                                    SelectedItem="{Binding SelectedServer, Mode=TwoWay}"
                                    DisplayMemberPath="Name"/>
                                <TextBlock Text="{DynamicResource Lang_ServerSource_Empty}" Foreground="{StaticResource MutedBrush}"
                                    FontSize="13" Margin="12,0,26,0" VerticalAlignment="Center" IsHitTestVisible="False">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Servers.Count}" Value="0">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </StackPanel>
                        <CheckBox x:Name="AutoDetectPortToggle" Style="{StaticResource ToggleSwitch}"
                                  IsChecked="{Binding Config.AutoDetectRemoteAppPort, Mode=TwoWay}">
                            <TextBlock Text="{DynamicResource Lang_Port_Auto}" TextWrapping="Wrap" Margin="0,0,12,0"/>
                        </CheckBox>
                        <TextBlock Text="{DynamicResource Lang_Port_AutoDescription}" Style="{StaticResource SectionDescription}" Margin="0,4,0,16"/>
                        <TextBlock Text="{DynamicResource Lang_RemoteAppPort}" Style="{StaticResource SettingLabel}" Margin="0,0,0,8"/>
                        <TextBox x:Name="RemoteAppPortInput" Width="144" HorizontalAlignment="Left"
                                 ToolTip="{DynamicResource Lang_Port_Range}" AutomationProperties.Name="{DynamicResource Lang_RemoteAppPort}">
                            <TextBox.Style>
                                <Style TargetType="TextBox" BasedOn="{StaticResource TextInput}">
                                    <Style.Triggers><DataTrigger Binding="{Binding Config.AutoDetectRemoteAppPort}" Value="True"><Setter Property="IsEnabled" Value="False"/></DataTrigger></Style.Triggers>
                                </Style>
                            </TextBox.Style>
                            <TextBox.Text>
                                <Binding Path="Config.RemoteAppPort" Mode="TwoWay" UpdateSourceTrigger="LostFocus" ValidatesOnExceptions="True">
                                    <Binding.ValidationRules><helpers:RemoteAppPortValidationRule/></Binding.ValidationRules>
                                </Binding>
                            </TextBox.Text>
                        </TextBox>
                        <TextBlock Text="{DynamicResource Lang_RemoteAppPort_Description}" Style="{StaticResource SectionDescription}" Margin="0,8,0,16"/>
                        <Border Height="1" Background="#DDE5E1" Margin="0,0,0,16"/>
                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="{DynamicResource Lang_Port_Active}" Style="{StaticResource SettingLabel}"/>
                            <TextBlock x:Name="ActiveRemoteAppPortText" Text="{Binding ActiveRemoteAppPort, TargetNullValue=—}" Style="{StaticResource ValueLabel}"/>
                        </Grid>
                        <TextBlock x:Name="PortDetectionStatus" Text="{Binding PortDetectionStatusText}" Style="{StaticResource SectionDescription}" Margin="0,0,0,12"/>
                        <TextBlock Text="{Binding ConnectionStatus}" TextWrapping="Wrap" FontSize="13" Margin="0,0,0,12" Foreground="{StaticResource MutedBrush}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsConnected}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                        <DataTrigger Binding="{Binding ConnectionStatus}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <WrapPanel>
                            <Button x:Name="DetectRemoteAppButton" Content="{DynamicResource Lang_Port_Detect}" Command="{Binding DetectRemoteAppCommand}" Style="{StaticResource QuietButton}" Margin="0,0,8,8"/>
                            <Button x:Name="ConnectionRefreshButton" Content="{DynamicResource Lang_Tray_Refresh}" Click="BtnRefresh_Click" Style="{StaticResource QuietButton}" Margin="0,0,0,8"/>
                        </WrapPanel>
                    </StackPanel>
                </ScrollViewer>
                <ScrollViewer x:Name="ApplicationScroller" Grid.Column="0" Background="#FFFFFF"
                    VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                    Visibility="{Binding IsChecked, ElementName=NavApplication, Converter={StaticResource BooleanVisibility}}">
                    <StackPanel x:Name="ApplicationSettings" Margin="32,24,32,24">
                        <TextBlock Text="{DynamicResource Lang_Settings_Application}" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="{DynamicResource Lang_Settings_ApplicationDescription}" Style="{StaticResource SectionDescription}" Margin="0,4,0,16"/>
                        <TextBlock Text="{DynamicResource Lang_Settings_Startup}" Style="{StaticResource SettingLabel}"/>
                        <StackPanel Margin="0,13,0,0">
                            <CheckBox Style="{StaticResource ToggleSwitch}"
                                IsChecked="{Binding Config.AutoStart, Mode=TwoWay}">
                                <TextBlock Text="{DynamicResource Lang_AutoStart}" TextWrapping="Wrap" Margin="0,0,10,0"/>
                            </CheckBox>
                            <TextBlock Text="{DynamicResource Lang_AutoStart_Description}"
                                Style="{StaticResource SectionDescription}" Margin="0,4,0,0"/>
                        </StackPanel>
                        <StackPanel Margin="0,13,0,0">
                            <CheckBox Style="{StaticResource ToggleSwitch}"
                                IsChecked="{Binding Config.AutoOpenWithTeamSpeak, Mode=TwoWay}">
                                <TextBlock Text="{DynamicResource Lang_AutoOpenWithTeamSpeak}" TextWrapping="Wrap" Margin="0,0,10,0"/>
                            </CheckBox>
                            <TextBlock Text="{DynamicResource Lang_AutoOpenWithTeamSpeak_Description}"
                                Style="{StaticResource SectionDescription}" Margin="0,4,0,0"/>
                        </StackPanel>
                        <Border Height="1" Background="#DDE5E1" Margin="0,24,0,16"/>
                        <TextBlock Text="{DynamicResource Lang_Update_Title}" Style="{StaticResource SettingLabel}"/>
                        <TextBlock Text="{DynamicResource Lang_Update_Description}" Style="{StaticResource SectionDescription}" Margin="0,4,0,9"/>
                        <TextBlock Text="{Binding UpdateStatusText}" FontSize="13" FontWeight="SemiBold"
                            Foreground="#147D64" TextWrapping="Wrap" Margin="0,0,0,10"/>
                        <WrapPanel>
                            <Button Content="{DynamicResource Lang_Update_Check}" Style="{StaticResource QuietButton}"
                                Command="{Binding CheckForUpdatesCommand}" Margin="0,0,9,8"/>
                            <Button Content="{DynamicResource Lang_Update_Download}" Style="{StaticResource PrimaryButton}"
                                Command="{Binding OpenUpdateCommand}" IsEnabled="{Binding IsUpdateAvailable}" Margin="0,0,0,8"/>
                        </WrapPanel>
                        <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding Config.CheckUpdatesOnStartup, Mode=TwoWay}">
                            <TextBlock Text="{DynamicResource Lang_Update_AutoCheck}" TextWrapping="Wrap"/>
                        </CheckBox>
                        <Border Height="1" Background="#DDE5E1" Margin="0,24,0,16"/>
                        <TextBlock Text="{DynamicResource Lang_Diagnostics}" Style="{StaticResource SettingLabel}"/>
                        <TextBlock Text="{DynamicResource Lang_Diagnostics_Description}" Style="{StaticResource SectionDescription}" Margin="0,4,0,11"/>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="{DynamicResource Lang_LogViewer_Open}" Style="{StaticResource QuietButton}" Margin="0,0,9,0" Click="BtnViewLogs_Click"/>
                            <Button Content="{DynamicResource Lang_Tray_OpenLogs}" Style="{StaticResource QuietButton}" Click="BtnOpenLogs_Click"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
                <Border Grid.Column="1" Background="#DDE5E1"/>
                <Border Grid.Column="2" Background="{StaticResource RailBrush}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="24">
                            <TextBlock Text="{DynamicResource Lang_LivePreview}" FontSize="14" FontWeight="SemiBold"/>
                            <TextBlock Text="{DynamicResource Lang_LivePreview_Description}" Style="{StaticResource SectionDescription}" Margin="0,4,0,12"/>
                            <Border Background="#0D2026" CornerRadius="14" Padding="10" Height="144">
                                <Border BorderBrush="#34515A" BorderThickness="1" CornerRadius="10" Padding="12" VerticalAlignment="{Binding Config.UserListAlignment}">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="HorizontalAlignment" Value="Stretch"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Config.AvatarDisplayMode}" Value="AvatarOnly">
                                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Border.Background>
                                        <SolidColorBrush Color="#193239" Opacity="{Binding Config.BackgroundOpacity}"/>
                                    </Border.Background>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid VerticalAlignment="Center">
                                            <Grid.Style>
                                                <Style TargetType="Grid">
                                                    <Setter Property="Width" Value="{Binding Config.AvatarSize}"/>
                                                    <Setter Property="Height" Value="{Binding Config.AvatarSize}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Config.AvatarDisplayMode}" Value="Indicator">
                                                            <Setter Property="Width" Value="10"/>
                                                            <Setter Property="Height" Value="10"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Config.AvatarDisplayMode}" Value="None">
                                                            <Setter Property="Width" Value="0"/>
                                                            <Setter Property="Height" Value="0"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Grid.Style>
                                            <Border x:Name="PreviewAvatar" CornerRadius="20">
                                                <TextBlock Text="N" FontSize="10" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Config.AvatarDisplayMode}" Value="Indicator">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                        <Setter Property="Background" Value="#305268"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Config.AvatarDisplayMode}" Value="Indicator">
                                                                <Setter Property="Background" Value="{Binding Config.TalkingBrush}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Config.AvatarDisplayMode}" Value="None">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                            </Border>
                                        </Grid>
                                        <TextBlock x:Name="PreviewUserName" Grid.Column="1" Text="Nova" FontFamily="{Binding Config.NameFontFamily}" FontSize="{Binding Config.FontSize}" FontWeight="SemiBold" Foreground="#F5FBFA" VerticalAlignment="Center" Margin="10,0" TextTrimming="CharacterEllipsis">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Config.AvatarDisplayMode}" Value="AvatarOnly">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" Height="16" VerticalAlignment="Center">
                                            <StackPanel.Style>
                                                <Style TargetType="StackPanel">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Config.AvatarDisplayMode}" Value="AvatarOnly">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </StackPanel.Style>
                                            <Border Width="3" Height="7" CornerRadius="1.5" Background="{Binding Config.TalkingBrush}" VerticalAlignment="Center"/>
                                            <Border Width="3" Height="14" CornerRadius="1.5" Background="{Binding Config.TalkingBrush}" VerticalAlignment="Center" Margin="3,0"/>
                                            <Border Width="3" Height="10" CornerRadius="1.5" Background="{Binding Config.TalkingBrush}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </Border>
                            <Border Height="1" Background="#DDE5E1" Margin="0,24"/>
                            <TextBlock Text="{DynamicResource Lang_Settings_AutoSaved}" Style="{StaticResource SectionDescription}"/>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>

            <Border Grid.Row="4" Background="{StaticResource SurfaceRaisedBrush}" BorderBrush="#DDE5E1" BorderThickness="0,1,0,0" CornerRadius="0,0,18,18">
                <Grid Margin="32,0">
                    <Button Content="{DynamicResource Lang_Reset}" Style="{StaticResource QuietButton}" HorizontalAlignment="Left" Click="BtnReset_Click"/>
                    <Button Content="{DynamicResource Lang_Save}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right" Click="BtnSave_Click"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
