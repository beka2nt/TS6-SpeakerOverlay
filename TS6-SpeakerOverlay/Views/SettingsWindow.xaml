<Window x:Class="TS6_SpeakerOverlay.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:TS6_SpeakerOverlay.Models"
        Title="{DynamicResource Lang_Settings_Title}"
        Width="960" Height="720"
        MinWidth="880" MinHeight="660"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterOwner"
        FontFamily="Microsoft YaHei UI, Segoe UI Variable Text, Segoe UI"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">
    <Window.Resources>
        <SolidColorBrush x:Key="SurfaceBrush" Color="#F2F7F7"/>
        <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="RailBrush" Color="#EDF5F4"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#D6E4E6"/>
        <SolidColorBrush x:Key="TextBrush" Color="#16323A"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#657C84"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#19B889"/>
        <SolidColorBrush x:Key="AccentHoverBrush" Color="#28C99A"/>
        <SolidColorBrush x:Key="VoiceBrush" Color="#19B889"/>

        <Style TargetType="{x:Type ScrollBar}">
            <Setter Property="Width" Value="10"/>
            <Setter Property="Background" Value="#F2F7F7"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Width="10" Background="{TemplateBinding Background}">
                            <Track x:Name="PART_Track" Orientation="Vertical" IsDirectionReversed="True"
                                   Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}"
                                   Value="{TemplateBinding Value}" ViewportSize="{TemplateBinding ViewportSize}">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Width="4" Margin="3,2" Background="#9EBBBA" CornerRadius="2"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="FontFamily" Value="Segoe UI Variable Display, Microsoft YaHei UI, Segoe UI"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="SectionDescription" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="LineHeight" Value="19"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style x:Key="SettingLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="ValueLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
        </Style>

        <Style x:Key="ThinSlider" TargetType="Slider">
            <Setter Property="Height" Value="24"/>
            <Setter Property="Focusable" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Background="Transparent">
                            <Border Height="4" CornerRadius="2" Background="#CFDFE0" VerticalAlignment="Center"/>
                            <Track x:Name="PART_Track" VerticalAlignment="Center">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="4" CornerRadius="2" Background="{StaticResource AccentBrush}"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="14" Height="14">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border x:Name="Dot" CornerRadius="7" Background="#FFFFFF" BorderBrush="{StaticResource AccentBrush}" BorderThickness="3"/>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Dot" Property="Background" Value="{StaticResource AccentHoverBrush}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" Background="Transparent" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <ControlTemplate x:Key="ComboToggleTemplate" TargetType="ToggleButton">
            <Border x:Name="Shell" Background="#FFFFFF" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="34"/></Grid.ColumnDefinitions>
                    <ContentPresenter Margin="12,0,6,0" VerticalAlignment="Center" HorizontalAlignment="Left"
                                      TextElement.Foreground="{StaticResource TextBrush}"/>
                    <Path Grid.Column="1" Width="8" Height="5" Stretch="Fill" Fill="{StaticResource MutedBrush}"
                          Data="M 0 0 L 4 4 L 8 0 Z" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Shell" Property="BorderBrush" Value="#71A99D"/></Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Shell" Property="BorderBrush" Value="{StaticResource AccentBrush}"/></Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <Style x:Key="ModernComboBoxItem" TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBorder" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="#E4F3EE"/></Trigger>
                            <Trigger Property="IsSelected" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="#CDECE0"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernComboBox" TargetType="ComboBox">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource ModernComboBoxItem}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton" Template="{StaticResource ComboToggleTemplate}"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                          ClickMode="Press"/>
                            <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom"
                                   AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                                <Border Margin="0,4,0,0" MinWidth="{Binding ActualWidth, ElementName=ToggleButton}"
                                        Padding="5" Background="#FFFFFF" BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1" CornerRadius="9">
                                    <ScrollViewer MaxHeight="240" CanContentScroll="True">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ToggleSwitch" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Background="Transparent" MinHeight="40">
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="44"/></Grid.ColumnDefinitions>
                            <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="True"/>
                            <Border x:Name="Track" Grid.Column="1" Width="38" Height="22" Background="#CAD9DD" CornerRadius="11" HorizontalAlignment="Right">
                                <Ellipse x:Name="Knob" Width="16" Height="16" Fill="#FFFFFF" HorizontalAlignment="Left" Margin="3"/>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="Knob" Property="Fill" Value="#EAF2F2"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Track" Property="Opacity" Value="0.9"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="QuietButton" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Background" Value="#EAF2F2"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#71A99D"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.75"/></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource QuietButton}">
            <Setter Property="MinWidth" Value="128"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{StaticResource AccentHoverBrush}"/><Setter Property="BorderBrush" Value="{StaticResource AccentHoverBrush}"/></Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ColorSwatchButton" TargetType="Button">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="SwatchBorder" CornerRadius="9" Background="#EAF2F2" BorderBrush="#B4CDCE" BorderThickness="1">
                            <Ellipse Width="18" Height="18" Fill="{TemplateBinding Background}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="SwatchBorder" Property="BorderBrush" Value="#16323A"/></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="SwatchBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="#F2F7F7" BorderBrush="#C8DADC" BorderThickness="1" CornerRadius="18">
        <Grid ClipToBounds="True">
            <Grid.RowDefinitions>
                <RowDefinition Height="78"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="72"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{StaticResource SurfaceRaisedBrush}" CornerRadius="18,18,0,0"
                    BorderBrush="#D6E4E6" BorderThickness="0,0,0,1" MouseDown="TitleBar_MouseDown">
                <Grid Margin="30,0,22,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="42"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="220"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="44"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="38" Height="38" Background="#DDF5ED" CornerRadius="11" HorizontalAlignment="Left">
                        <Grid Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Rectangle Width="3" Height="8" RadiusX="1.5" Fill="{StaticResource AccentBrush}" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                            <Rectangle Width="3" Height="16" RadiusX="1.5" Fill="{StaticResource AccentBrush}" HorizontalAlignment="Center"/>
                            <Rectangle Width="3" Height="11" RadiusX="1.5" Fill="{StaticResource VoiceBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="2,0,0,0">
                        <TextBlock Text="{DynamicResource Lang_Settings_Title}" FontFamily="Segoe UI Variable Display, Microsoft YaHei UI, Segoe UI" FontSize="22" FontWeight="SemiBold"/>
                        <TextBlock Text="{DynamicResource Lang_Settings_Subtitle}" Foreground="{StaticResource MutedBrush}" FontSize="11.5" Margin="0,3,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Width="204" VerticalAlignment="Center" Margin="0,0,14,0"
                                ToolTip="{DynamicResource Lang_ServerSource_Description}">
                        <TextBlock Text="{DynamicResource Lang_ServerSource}" Foreground="{StaticResource MutedBrush}" FontSize="10.5" Margin="2,0,0,3"/>
                        <Grid>
                        <ComboBox Style="{StaticResource ModernComboBox}" Height="32"
                                  ItemsSource="{Binding Servers}"
                                  SelectedItem="{Binding SelectedServer, Mode=TwoWay}"
                                  DisplayMemberPath="Name"/>
                        <TextBlock Text="{DynamicResource Lang_ServerSource_Empty}" Foreground="{StaticResource MutedBrush}"
                                   FontSize="12" Margin="12,0,26,0" VerticalAlignment="Center" IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Servers.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        </Grid>
                    </StackPanel>
                    <Border Grid.Column="3" Background="#E5F0F0" CornerRadius="12" Padding="10,5" VerticalAlignment="Center" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="ConnectionDot" Width="7" Height="7" VerticalAlignment="Center" Margin="0,0,7,0">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="#83979B"/>
                                        <Style.Triggers><DataTrigger Binding="{Binding IsConnected}" Value="True"><Setter Property="Fill" Value="{StaticResource VoiceBrush}"/></DataTrigger></Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock FontSize="11.5" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                        <Setter Property="Text" Value="{DynamicResource Lang_Status_Waiting}"/>
                                        <Style.Triggers><DataTrigger Binding="{Binding IsConnected}" Value="True"><Setter Property="Text" Value="{DynamicResource Lang_Status_Connected}"/></DataTrigger></Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                    <Button Grid.Column="4" Width="34" Height="34" Background="Transparent" BorderThickness="0" Foreground="{StaticResource MutedBrush}"
                            FontSize="21" FontWeight="Light" Content="×" Cursor="Hand" Click="BtnClose_Click" ToolTip="Close">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="CloseBorder" CornerRadius="8" Background="{TemplateBinding Background}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-2,0,0"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="CloseBorder" Property="Background" Value="#FBE9E9"/><Setter Property="Foreground" Value="#BD4E5B"/></Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="1"/>
                    <ColumnDefinition Width="310"/>
                </Grid.ColumnDefinitions>

                <ScrollViewer Grid.Column="0" Background="#FFFFFF" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="34,28,34,30">
                        <TextBlock Text="{DynamicResource Lang_Appearance}" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="{DynamicResource Lang_Appearance_Description}" Style="{StaticResource SectionDescription}" Margin="0,5,0,21"/>

                        <Grid Margin="0,0,0,21">
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="225"/></Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,22,0">
                                <TextBlock Text="{DynamicResource Lang_AvatarMode}" Style="{StaticResource SettingLabel}"/>
                                <TextBlock Text="{DynamicResource Lang_AvatarMode_Description}" Style="{StaticResource SectionDescription}" Margin="0,4,0,0"/>
                            </StackPanel>
                            <ComboBox Grid.Column="1" Style="{StaticResource ModernComboBox}"
                                      SelectedValuePath="Tag" SelectedValue="{Binding Config.AvatarDisplayMode, Mode=TwoWay}">
                                <ComboBoxItem Content="{DynamicResource Lang_Mode_Avatar}" Tag="{x:Static models:AvatarMode.Avatar}"/>
                                <ComboBoxItem Content="{DynamicResource Lang_Mode_AvatarOnly}" Tag="{x:Static models:AvatarMode.AvatarOnly}"/>
                                <ComboBoxItem Content="{DynamicResource Lang_Mode_Indicator}" Tag="{x:Static models:AvatarMode.Indicator}"/>
                                <ComboBoxItem Content="{DynamicResource Lang_Mode_None}" Tag="{x:Static models:AvatarMode.None}"/>
                            </ComboBox>
                        </Grid>

                        <Border Height="1" Background="#DCE8E9" Margin="0,0,0,20"/>

                        <StackPanel Margin="0,0,0,20">
                            <Grid>
                                <TextBlock Text="{DynamicResource Lang_TalkingColor}" Style="{StaticResource SettingLabel}"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Ellipse Width="12" Height="12" Fill="{Binding Config.TalkingBrush}" VerticalAlignment="Center" Margin="0,0,7,0"/>
                                    <TextBlock Text="{Binding Config.TalkingColor}" Style="{StaticResource ValueLabel}"/>
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="{DynamicResource Lang_TalkingColor_Description}" Style="{StaticResource SectionDescription}" Margin="0,4,0,10"/>
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource ColorSwatchButton}" Background="#19B889" Tag="#19B889" ToolTip="Mint" Click="TalkingColorPreset_Click"/>
                                <Button Style="{StaticResource ColorSwatchButton}" Background="#58BEFF" Tag="#58BEFF" ToolTip="Sky" Click="TalkingColorPreset_Click"/>
                                <Button Style="{StaticResource ColorSwatchButton}" Background="#B49AFF" Tag="#B49AFF" ToolTip="Violet" Click="TalkingColorPreset_Click"/>
                                <Button Style="{StaticResource ColorSwatchButton}" Background="#FFBF69" Tag="#FFBF69" ToolTip="Amber" Click="TalkingColorPreset_Click"/>
                                <Button Style="{StaticResource ColorSwatchButton}" Background="#FF85A6" Tag="#FF85A6" ToolTip="Rose" Click="TalkingColorPreset_Click"/>
                                <Button Style="{StaticResource ColorSwatchButton}" Background="#F0F5FF" Tag="#F0F5FF" ToolTip="Ice" Click="TalkingColorPreset_Click"/>
                                <Button Content="{DynamicResource Lang_TalkingColor_Custom}" Style="{StaticResource QuietButton}" Height="32" Padding="12,0" Click="TalkingColorCustom_Click"/>
                            </StackPanel>
                        </StackPanel>

                        <Border Height="1" Background="#DCE8E9" Margin="0,0,0,20"/>

                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="24"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <Grid><TextBlock Text="{DynamicResource Lang_FontSize}" Style="{StaticResource SettingLabel}"/><TextBlock Text="{Binding Config.FontSize, StringFormat={}{0:0} px}" Style="{StaticResource ValueLabel}"/></Grid>
                                <Slider Style="{StaticResource ThinSlider}" Minimum="10" Maximum="24" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding Config.FontSize, Mode=TwoWay}" Margin="0,7,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <Grid><TextBlock Text="{DynamicResource Lang_AvatarSize}" Style="{StaticResource SettingLabel}"/><TextBlock Text="{Binding Config.AvatarSize, StringFormat={}{0:0} px}" Style="{StaticResource ValueLabel}"/></Grid>
                                <Slider Style="{StaticResource ThinSlider}" Minimum="14" Maximum="38" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding Config.AvatarSize, Mode=TwoWay}" Margin="0,7,0,0"/>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,24,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="24"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <Grid><TextBlock Text="{DynamicResource Lang_Spacing}" Style="{StaticResource SettingLabel}"/><TextBlock Text="{Binding Config.ItemSpacing, StringFormat={}{0:0} px}" Style="{StaticResource ValueLabel}"/></Grid>
                                <Slider Style="{StaticResource ThinSlider}" Minimum="0" Maximum="16" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding Config.ItemSpacing, Mode=TwoWay}" Margin="0,7,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <Grid><TextBlock Text="{DynamicResource Lang_Opacity}" Style="{StaticResource SettingLabel}"/><TextBlock Text="{Binding Config.BackgroundOpacity, StringFormat={}{0:P0}}" Style="{StaticResource ValueLabel}"/></Grid>
                                <Slider Style="{StaticResource ThinSlider}" Minimum="0.15" Maximum="1" TickFrequency="0.05" IsSnapToTickEnabled="True" Value="{Binding Config.BackgroundOpacity, Mode=TwoWay}" Margin="0,7,0,0"/>
                            </StackPanel>
                        </Grid>

                        <StackPanel Margin="0,24,0,0">
                            <Grid><TextBlock Text="{DynamicResource Lang_Scale}" Style="{StaticResource SettingLabel}"/><TextBlock Text="{Binding Config.UiScale, StringFormat={}{0:P0}}" Style="{StaticResource ValueLabel}"/></Grid>
                            <Slider Style="{StaticResource ThinSlider}" Minimum="0.65" Maximum="1.5" TickFrequency="0.05" IsSnapToTickEnabled="True" Value="{Binding Config.UiScale, Mode=TwoWay}" Margin="0,7,0,0"/>
                        </StackPanel>

                        <Border Height="1" Background="#DCE8E9" Margin="0,30,0,24"/>
                        <TextBlock Text="{DynamicResource Lang_ConnectionSettings}" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="{DynamicResource Lang_ConnectionSettings_Description}" Style="{StaticResource SectionDescription}" Margin="0,5,0,22"/>

                        <TextBlock Text="{DynamicResource Lang_RemoteAppPort}" Style="{StaticResource SettingLabel}" Margin="0,0,0,8"/>
                        <ComboBox Style="{StaticResource ModernComboBox}" ItemsSource="{Binding RemoteAppPorts}"
                                  SelectedItem="{Binding Config.RemoteAppPort, Mode=TwoWay}"/>
                        <TextBlock Text="{DynamicResource Lang_RemoteAppPort_Description}" Style="{StaticResource SectionDescription}" Margin="0,7,0,22"/>

                        <TextBlock Text="{DynamicResource Lang_Language}" Style="{StaticResource SettingLabel}"/>
                        <TextBlock Text="{DynamicResource Lang_Language_Description}" Style="{StaticResource SectionDescription}" Margin="0,4,0,9"/>
                        <ComboBox Style="{StaticResource ModernComboBox}" SelectedValuePath="Tag" SelectedValue="{Binding Config.Language, Mode=TwoWay}"
                                  SelectionChanged="LanguageComboBox_SelectionChanged">
                            <ComboBoxItem Content="简体中文" Tag="zh-CN"/>
                            <ComboBoxItem Content="English" Tag="en-US"/>
                            <ComboBoxItem Content="Français" Tag="fr-FR"/>
                            <ComboBoxItem Content="Русский" Tag="ru-RU"/>
                        </ComboBox>

                        <Border Height="1" Background="#DCE8E9" Margin="0,24,0,20"/>
                        <TextBlock Text="{DynamicResource Lang_Diagnostics}" Style="{StaticResource SettingLabel}"/>
                        <TextBlock Text="{DynamicResource Lang_Diagnostics_Description}" Style="{StaticResource SectionDescription}" Margin="0,4,0,11"/>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="{DynamicResource Lang_LogViewer_Open}" Style="{StaticResource QuietButton}" Margin="0,0,9,0" Click="BtnViewLogs_Click"/>
                            <Button Content="{DynamicResource Lang_Tray_OpenLogs}" Style="{StaticResource QuietButton}" Click="BtnOpenLogs_Click"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <Border Grid.Column="1" Background="#D6E4E6"/>

                <Border Grid.Column="2" Background="{StaticResource RailBrush}" CornerRadius="0,0,0,0">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="26,27,26,24">
                            <TextBlock Text="{DynamicResource Lang_LivePreview}" FontSize="14" FontWeight="SemiBold"/>
                            <TextBlock Text="{DynamicResource Lang_LivePreview_Description}" Style="{StaticResource SectionDescription}" Margin="0,4,0,12"/>

                            <Border Background="#0D2026" CornerRadius="14" Padding="10">
                            <Border BorderBrush="#34515A" BorderThickness="1" CornerRadius="10" Padding="12">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="HorizontalAlignment" Value="Stretch"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Config.AvatarDisplayMode}" Value="AvatarOnly">
                                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Border.Background>
                                    <SolidColorBrush Color="#193239" Opacity="{Binding Config.BackgroundOpacity}"/>
                                </Border.Background>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <Grid VerticalAlignment="Center">
                                        <Grid.Style>
                                            <Style TargetType="Grid">
                                                <Setter Property="Width" Value="{Binding Config.AvatarSize}"/>
                                                <Setter Property="Height" Value="{Binding Config.AvatarSize}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Config.AvatarDisplayMode}" Value="Indicator"><Setter Property="Width" Value="10"/><Setter Property="Height" Value="10"/></DataTrigger>
                                                    <DataTrigger Binding="{Binding Config.AvatarDisplayMode}" Value="None"><Setter Property="Width" Value="0"/><Setter Property="Height" Value="0"/></DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Grid.Style>
                                        <Border x:Name="PreviewAvatar" CornerRadius="20">
                                            <TextBlock Text="N" FontSize="10" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                                        <Style.Triggers><DataTrigger Binding="{Binding Config.AvatarDisplayMode}" Value="Indicator"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Setter Property="Background" Value="#305268"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Config.AvatarDisplayMode}" Value="Indicator"><Setter Property="Background" Value="{Binding Config.TalkingBrush}"/></DataTrigger>
                                                        <DataTrigger Binding="{Binding Config.AvatarDisplayMode}" Value="None"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                        </Border>
                                    </Grid>
                                    <TextBlock Grid.Column="1" Text="Nova" FontSize="{Binding Config.FontSize}" FontWeight="SemiBold" Foreground="#F5FBFA" VerticalAlignment="Center" Margin="10,0" TextTrimming="CharacterEllipsis">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Config.AvatarDisplayMode}" Value="AvatarOnly"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Height="16" VerticalAlignment="Center">
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Config.AvatarDisplayMode}" Value="AvatarOnly"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <Border Width="3" Height="7" CornerRadius="1.5" Background="{Binding Config.TalkingBrush}" VerticalAlignment="Center"/>
                                        <Border Width="3" Height="14" CornerRadius="1.5" Background="{Binding Config.TalkingBrush}" VerticalAlignment="Center" Margin="3,0"/>
                                        <Border Width="3" Height="10" CornerRadius="1.5" Background="{Binding Config.TalkingBrush}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            </Border>

                            <Border Height="1" Background="#DCE8E9" Margin="0,22"/>

                            <TextBlock Text="{DynamicResource Lang_Behavior}" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <CheckBox Content="{DynamicResource Lang_EnableNotify}" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding Config.EnableNotifications, Mode=TwoWay}"/>
                            <Border BorderBrush="#BDD8D3" BorderThickness="2,0,0,0" Padding="10,0,0,0" Margin="3,3,0,8">
                                <StackPanel>
                                    <CheckBox Style="{StaticResource ToggleSwitch}" Foreground="#48656D" IsChecked="{Binding Config.EnableServerNotifications, Mode=TwoWay}"
                                              IsEnabled="{Binding Config.EnableNotifications}">
                                        <TextBlock Text="{DynamicResource Lang_ServerNotifications}" TextWrapping="Wrap"/>
                                    </CheckBox>
                                    <CheckBox Style="{StaticResource ToggleSwitch}" Foreground="#48656D" IsChecked="{Binding Config.EnableChannelNotifications, Mode=TwoWay}"
                                              IsEnabled="{Binding Config.EnableNotifications}">
                                        <TextBlock Text="{DynamicResource Lang_ChannelNotifications}" TextWrapping="Wrap"/>
                                    </CheckBox>
                                </StackPanel>
                            </Border>
                            <StackPanel>
                                <CheckBox Content="{DynamicResource Lang_ShowOnlyTalking}" Style="{StaticResource ToggleSwitch}"
                                          IsChecked="{Binding Config.ShowOnlyTalking, Mode=TwoWay}"/>
                                <TextBlock Text="{DynamicResource Lang_ShowOnlyTalking_Description}"
                                           Style="{StaticResource SectionDescription}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                            </StackPanel>
                            <StackPanel Margin="0,13,0,0">
                                <CheckBox Content="{DynamicResource Lang_AutoOpenWithTeamSpeak}" Style="{StaticResource ToggleSwitch}"
                                          IsChecked="{Binding Config.AutoOpenWithTeamSpeak, Mode=TwoWay}"/>
                                <TextBlock Text="{DynamicResource Lang_AutoOpenWithTeamSpeak_Description}"
                                           Style="{StaticResource SectionDescription}" Margin="0,3,0,0"/>
                            </StackPanel>

                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>

            <Border Grid.Row="2" Background="{StaticResource SurfaceRaisedBrush}" BorderBrush="#D6E4E6" BorderThickness="0,1,0,0" CornerRadius="0,0,18,18">
                <Grid Margin="30,0">
                    <Button Content="{DynamicResource Lang_Reset}" Style="{StaticResource QuietButton}" HorizontalAlignment="Left" Click="BtnReset_Click"/>
                    <Button Content="{DynamicResource Lang_Save}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right" Click="BtnSave_Click"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
